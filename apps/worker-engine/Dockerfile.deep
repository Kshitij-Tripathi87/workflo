# syntax=docker/dockerfile:1
# Release deep worker: pinned llama.cpp + pinned GGUF base and three adapters.
# Build context must be the repository root. The build intentionally fails when
# the image digest, artifact files, or SHA-256 build arguments are absent.
#
# Example (values must come from the frozen release manifest):
#   docker build -f apps/worker-engine/Dockerfile.deep \
#     --build-arg LLAMACPP_IMAGE='ghcr.io/ggml-org/llama.cpp:server@sha256:...' \
#     --build-arg WORKFLO_RELEASE_COMMIT='<40-character-sha>' \
#     --build-arg BASE_GGUF_SHA256=... \
#     --build-arg TEST_GEN_GGUF_SHA256=... \
#     --build-arg REASONING_GGUF_SHA256=... \
#     --build-arg REPORTING_GGUF_SHA256=... \
#     -t workflo-worker-deep:release .

ARG LLAMACPP_IMAGE
FROM ${LLAMACPP_IMAGE} AS llamacpp

FROM python:3.11-slim AS runtime

ARG LLAMACPP_IMAGE
ARG BASE_GGUF_SHA256
ARG TEST_GEN_GGUF_SHA256
ARG REASONING_GGUF_SHA256
ARG REPORTING_GGUF_SHA256
ARG WORKFLO_LLAMACPP_MODEL_ID
ARG WORKFLO_RELEASE_COMMIT

LABEL org.opencontainers.image.base.name="${LLAMACPP_IMAGE}" \
      org.opencontainers.image.revision="${WORKFLO_RELEASE_COMMIT}" \
      dev.workflo.model.id="${WORKFLO_LLAMACPP_MODEL_ID}" \
      dev.workflo.model.base.sha256="${BASE_GGUF_SHA256}" \
      dev.workflo.adapter.test-gen.sha256="${TEST_GEN_GGUF_SHA256}" \
      dev.workflo.adapter.reasoning.sha256="${REASONING_GGUF_SHA256}" \
      dev.workflo.adapter.reporting.sha256="${REPORTING_GGUF_SHA256}"

WORKDIR /app

# Reject malformed release identity before package installation or large model
# layers. Content mismatches are checked again after the GGUF files are copied.
RUN set -eu; \
    case "$LLAMACPP_IMAGE" in *@sha256:*) ;; \
      *) echo "LLAMACPP_IMAGE must be pinned by sha256 digest" >&2; exit 1 ;; esac; \
    image_digest="${LLAMACPP_IMAGE##*@sha256:}"; \
    echo "$image_digest" | grep -Eq '^[0-9a-f]{64}$'; \
    test -n "$WORKFLO_LLAMACPP_MODEL_ID"; \
    echo "$WORKFLO_RELEASE_COMMIT" | grep -Eq '^[0-9a-f]{40}$'; \
    for value in \
      "$BASE_GGUF_SHA256" "$TEST_GEN_GGUF_SHA256" \
      "$REASONING_GGUF_SHA256" "$REPORTING_GGUF_SHA256"; do \
      echo "$value" | grep -Eq '^[0-9a-f]{64}$'; \
    done

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates git curl \
    && rm -rf /var/lib/apt/lists/*

# Keep the official image's binary and sibling shared libraries together.
COPY --from=llamacpp /app/ /opt/llamacpp/
RUN test -x /opt/llamacpp/llama-server

COPY packages/workflo-schema/ /app/packages/workflo-schema/
COPY packages/workflo-utils/ /app/packages/workflo-utils/
COPY packages/probe-engine/ /app/packages/probe-engine/
COPY workflo-ai-integration/ /app/workflo-ai-integration/
COPY apps/worker-engine/pyproject.toml /app/worker-engine/pyproject.toml
COPY apps/worker-engine/src/ /app/worker-engine/src/
COPY scripts/release/llamacpp_worker_smoke.py /app/scripts/release/llamacpp_worker_smoke.py

RUN pip install --no-cache-dir \
      /app/packages/workflo-schema \
      /app/packages/workflo-utils \
      /app/packages/probe-engine \
      /app/workflo-ai-integration \
      /app/worker-engine

# Static release assets. They are deliberately absent from Git and must be
# staged by the release owner before this image can build.
COPY workflo-ai-integration/serving/models/base.gguf /models/base.gguf
COPY workflo-ai-integration/serving/adapters/test-gen.gguf /adapters/test-gen.gguf
COPY workflo-ai-integration/serving/adapters/reasoning.gguf /adapters/reasoning.gguf
COPY workflo-ai-integration/serving/adapters/reporting.gguf /adapters/reporting.gguf

# Verify before the image layer is accepted. Empty/malformed values and stale
# artifacts fail the build rather than reaching a production-like run.
RUN set -eu; \
    case "$LLAMACPP_IMAGE" in *@sha256:*) ;; \
      *) echo "LLAMACPP_IMAGE must be pinned by sha256 digest" >&2; exit 1 ;; esac; \
    image_digest="${LLAMACPP_IMAGE##*@sha256:}"; \
    echo "$image_digest" | grep -Eq '^[0-9a-f]{64}$' || { echo "invalid llama.cpp image digest" >&2; exit 1; }; \
    for value in \
      "$BASE_GGUF_SHA256" "$TEST_GEN_GGUF_SHA256" \
      "$REASONING_GGUF_SHA256" "$REPORTING_GGUF_SHA256"; do \
      echo "$value" | grep -Eq '^[0-9a-f]{64}$' || { echo "invalid GGUF SHA-256" >&2; exit 1; }; \
    done; \
    echo "$BASE_GGUF_SHA256  /models/base.gguf" | sha256sum -c -; \
    echo "$TEST_GEN_GGUF_SHA256  /adapters/test-gen.gguf" | sha256sum -c -; \
    echo "$REASONING_GGUF_SHA256  /adapters/reasoning.gguf" | sha256sum -c -; \
    echo "$REPORTING_GGUF_SHA256  /adapters/reporting.gguf" | sha256sum -c -; \
    test -n "$WORKFLO_LLAMACPP_MODEL_ID"; \
    echo "$WORKFLO_RELEASE_COMMIT" | grep -Eq '^[0-9a-f]{40}$' || { echo "invalid release commit" >&2; exit 1; }; \
    chmod 0444 /models/base.gguf /adapters/*.gguf

ENV PATH="/opt/llamacpp:${PATH}" \
    LD_LIBRARY_PATH="/opt/llamacpp" \
    PYTHONUNBUFFERED=1 \
    WORKER_MODE=queue \
    WORKFLO_MODEL_BACKEND=llamacpp \
    WORKFLO_LLAMACPP_BINARY=/opt/llamacpp/llama-server \
    WORKFLO_LLAMACPP_HOST=127.0.0.1 \
    WORKFLO_LLAMACPP_PORT=8080 \
    WORKFLO_LLAMACPP_CONTEXT=8192 \
    WORKFLO_LLAMACPP_BASE_GGUF=/models/base.gguf \
    WORKFLO_LLAMACPP_TEST_GEN_GGUF=/adapters/test-gen.gguf \
    WORKFLO_LLAMACPP_REASONING_GGUF=/adapters/reasoning.gguf \
    WORKFLO_LLAMACPP_REPORTING_GGUF=/adapters/reporting.gguf \
    WORKFLO_LLAMACPP_IMAGE="${LLAMACPP_IMAGE}" \
    WORKFLO_LLAMACPP_MODEL_ID="${WORKFLO_LLAMACPP_MODEL_ID}" \
    WORKFLO_LLAMACPP_BASE_SHA256="${BASE_GGUF_SHA256}" \
    WORKFLO_LLAMACPP_TEST_GEN_SHA256="${TEST_GEN_GGUF_SHA256}" \
    WORKFLO_LLAMACPP_REASONING_SHA256="${REASONING_GGUF_SHA256}" \
    WORKFLO_LLAMACPP_REPORTING_SHA256="${REPORTING_GGUF_SHA256}"

WORKDIR /app/worker-engine
CMD ["python", "-m", "workflo_worker.main"]
