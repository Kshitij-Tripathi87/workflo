NODE_ENV=development

# Postgres
DATABASE_URL=postgresql://workflo:workflo@localhost:5432/workflo

# Queue / realtime
REDIS_URL=redis://localhost:6379

# Inference
INFERENCE_GATEWAY_URL=http://localhost:8080/v1
INFERENCE_MODEL_ID=qwen3-4b-4bit

# Speech provider API keys (optional operator-managed defaults).
# Do not commit real values. For customer BYOK, configure a project key
# through Settings; it is encrypted with the organization's DEK.
SARVAM_API_KEY=
SARVAM_TTS_SPEAKER=simran_en_customer
FISH_API_KEY=
FISH_TTS_REFERENCE_ID=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
VOICE_HTTP_TIMEOUT_SECONDS=60
# Project-level BYOK storage requires a 32-byte KEK in hex in development.
# In production, use the approved KMS-backed KEK provider.
MASTER_KEK_HEX=

# Dashboard origins allowed to call the control plane.
DASHBOARD_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Unauthenticated credential bootstrap. Both are default-closed in code;
# enable them only on a local development instance. Production refuses the
# demo token unconditionally.
# ENABLE_DEMO_TOKEN=true      # POST /v1/auth/demo-token (fixed admin-scoped key)
# ALLOW_ANONYMOUS_KEY_BOOTSTRAP=true   # POST /v1/keys with no credential

# Signing
WORKFLO_SIGNING_KEY_PROVIDER=file
WORKFLO_SIGNING_KEY_PATH=./secrets/dev-ed25519.key

# Transparency
WORKFLO_TRANSPARENCY_LOG_PATH=./var/transparency/log.jsonl

# GitHub
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_PATH=

# Sandbox
SANDBOX_RUNTIME=bwrap
SANDBOX_ROOT=/var/lib/workflo/sandboxes

# Explorer budgets
WORKFLO_MAX_TOOL_CALLS=20
WORKFLO_HARD_TOOL_CALL_LIMIT=30
WORKFLO_MAX_MODEL_TURNS=20
WORKFLO_MAX_OBSERVATION_BYTES_PER_TURN=8192
WORKFLO_MAX_TOTAL_OBSERVATION_BYTES=65536
WORKFLO_MAX_WALL_TIME_SECONDS=900
