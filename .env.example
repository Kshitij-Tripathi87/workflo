NODE_ENV=development

# Postgres
DATABASE_URL=postgresql://workflo:workflo@localhost:5432/workflo

# Queue / realtime
REDIS_URL=redis://localhost:6379

# Inference
INFERENCE_GATEWAY_URL=http://localhost:8080/v1
INFERENCE_MODEL_ID=qwen3-4b-4bit

# Signing
WORKFLO_SIGNING_KEY_PROVIDER=file
WORKFLO_SIGNING_KEY_PATH=./secrets/dev-ed25519.key

# Transparency
WORKFLO_TRANSPARENCY_LOG_PATH=./var/transparency/log.jsonl

# GitHub
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_PATH=

# Sandbox
SANDBOX_RUNTIME=bwrap
SANDBOX_ROOT=/var/lib/workflo/sandboxes

# Explorer budgets
WORKFLO_MAX_TOOL_CALLS=20
WORKFLO_HARD_TOOL_CALL_LIMIT=30
WORKFLO_MAX_MODEL_TURNS=20
WORKFLO_MAX_OBSERVATION_BYTES_PER_TURN=8192
WORKFLO_MAX_TOTAL_OBSERVATION_BYTES=65536
WORKFLO_MAX_WALL_TIME_SECONDS=900
