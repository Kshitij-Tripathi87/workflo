{
  "$defs": {
    "Requirement": {
      "additionalProperties": false,
      "properties": {
        "priority": {
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "req_id": {
          "pattern": "^REQ-[0-9]{3,}$",
          "title": "Req Id",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_file": {
          "minLength": 1,
          "title": "Source File",
          "type": "string"
        },
        "source_line": {
          "minimum": 1,
          "title": "Source Line",
          "type": "integer"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "req_id",
        "text",
        "source_file",
        "source_line",
        "priority"
      ],
      "title": "Requirement",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/Requirement"
      },
      "title": "Items",
      "type": "array"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "items"
  ],
  "title": "RequirementSet",
  "type": "object"
}
