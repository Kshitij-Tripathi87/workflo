{
  "additionalProperties": false,
  "description": "What a sealed sandbox looks like once it is up.",
  "properties": {
    "app_url": {
      "pattern": "^https?://",
      "title": "App Url",
      "type": "string"
    },
    "backend": {
      "enum": [
        "docker",
        "namespaces"
      ],
      "title": "Backend",
      "type": "string"
    },
    "canary_result": {
      "enum": [
        "blocked",
        "leaked",
        "not_run"
      ],
      "title": "Canary Result",
      "type": "string"
    },
    "image_digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Image Digest"
    },
    "network_profile": {
      "minLength": 1,
      "title": "Network Profile",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "backend",
    "app_url",
    "network_profile",
    "canary_result",
    "started_at"
  ],
  "title": "SandboxHandle",
  "type": "object"
}
