{
  "additionalProperties": false,
  "description": "Everything a run needs before the sandbox exists.",
  "properties": {
    "backend": {
      "enum": [
        "docker",
        "namespaces"
      ],
      "title": "Backend",
      "type": "string"
    },
    "commit": {
      "minLength": 1,
      "title": "Commit",
      "type": "string"
    },
    "config": {
      "additionalProperties": true,
      "title": "Config",
      "type": "object"
    },
    "privacy_mode": {
      "enum": [
        "local-only",
        "hybrid",
        "observation-only"
      ],
      "title": "Privacy Mode",
      "type": "string"
    },
    "repo_ref": {
      "minLength": 1,
      "title": "Repo Ref",
      "type": "string"
    },
    "requirements_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requirements Path"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Sha256",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "repo_ref",
    "commit",
    "snapshot_sha256",
    "backend",
    "privacy_mode",
    "config"
  ],
  "title": "RunInput",
  "type": "object"
}
