{
  "additionalProperties": false,
  "description": "One append-only lifecycle event; bodies live behind payload_hash.",
  "properties": {
    "kind": {
      "minLength": 1,
      "title": "Kind",
      "type": "string"
    },
    "payload_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Payload Hash",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "seq": {
      "minimum": 0,
      "title": "Seq",
      "type": "integer"
    },
    "stage": {
      "minLength": 1,
      "title": "Stage",
      "type": "string"
    },
    "ts": {
      "format": "date-time",
      "title": "Ts",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "seq",
    "ts",
    "stage",
    "kind",
    "payload_hash"
  ],
  "title": "EventRecord",
  "type": "object"
}
