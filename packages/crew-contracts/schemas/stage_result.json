{
  "additionalProperties": false,
  "description": "Outcome of one orchestrator stage.",
  "properties": {
    "duration_ms": {
      "minimum": 0,
      "title": "Duration Ms",
      "type": "integer"
    },
    "failure_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Reason"
    },
    "failure_stage": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Stage"
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "stage": {
      "enum": [
        "snapshot",
        "sandbox_ready",
        "analyze",
        "explore_baseline",
        "judge",
        "explore_llm",
        "report",
        "teardown"
      ],
      "title": "Stage",
      "type": "string"
    }
  },
  "required": [
    "stage",
    "ok",
    "duration_ms"
  ],
  "title": "StageResult",
  "type": "object"
}
