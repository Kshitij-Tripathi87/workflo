{
  "$defs": {
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "control_evidence_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Control Evidence Ref"
        },
        "finding_id": {
          "minLength": 1,
          "title": "Finding Id",
          "type": "string"
        },
        "fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fingerprint",
          "type": "string"
        },
        "repro_evidence_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Repro Evidence Refs",
          "type": "array"
        },
        "req_id": {
          "anyOf": [
            {
              "pattern": "^REQ-[0-9]{3,}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Req Id"
        },
        "schema_version": {
          "default": 1,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "severity": {
          "minLength": 1,
          "title": "Severity",
          "type": "string"
        },
        "status": {
          "enum": [
            "Confirmed",
            "Flaky",
            "Unconfirmed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "fingerprint",
        "status",
        "confidence",
        "severity",
        "repro_evidence_refs"
      ],
      "title": "Finding",
      "type": "object"
    },
    "IsolationProof": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "enum": [
            "docker",
            "namespaces"
          ],
          "title": "Backend",
          "type": "string"
        },
        "canary_result": {
          "enum": [
            "blocked",
            "leaked",
            "not_run"
          ],
          "title": "Canary Result",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "teardown_verified": {
          "title": "Teardown Verified",
          "type": "boolean"
        }
      },
      "required": [
        "backend",
        "canary_result",
        "teardown_verified"
      ],
      "title": "IsolationProof",
      "type": "object"
    },
    "ProviderProvenance": {
      "additionalProperties": false,
      "properties": {
        "calls": {
          "minimum": 1,
          "title": "Calls",
          "type": "integer"
        },
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "privacy_mode": {
          "enum": [
            "local-only",
            "hybrid",
            "observation-only"
          ],
          "title": "Privacy Mode",
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "provider",
        "model_id",
        "privacy_mode",
        "calls"
      ],
      "title": "ProviderProvenance",
      "type": "object"
    },
    "RequirementStatus": {
      "additionalProperties": false,
      "properties": {
        "req_id": {
          "pattern": "^REQ-[0-9]{3,}$",
          "title": "Req Id",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "status": {
          "enum": [
            "verified",
            "failing",
            "uncovered",
            "inconclusive"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "req_id",
        "status"
      ],
      "title": "RequirementStatus",
      "type": "object"
    },
    "RunSummary": {
      "additionalProperties": false,
      "properties": {
        "duration_seconds": {
          "minimum": 0.0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "failed": {
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "passed": {
          "minimum": 0,
          "title": "Passed",
          "type": "integer"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "skipped": {
          "minimum": 0,
          "title": "Skipped",
          "type": "integer"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "run_id",
        "total",
        "passed",
        "failed",
        "skipped",
        "duration_seconds"
      ],
      "title": "RunSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "isolation_proof": {
      "$ref": "#/$defs/IsolationProof"
    },
    "model_stage_degraded": {
      "title": "Model Stage Degraded",
      "type": "boolean"
    },
    "provider_provenance": {
      "items": {
        "$ref": "#/$defs/ProviderProvenance"
      },
      "title": "Provider Provenance",
      "type": "array"
    },
    "requirement_statuses": {
      "items": {
        "$ref": "#/$defs/RequirementStatus"
      },
      "title": "Requirement Statuses",
      "type": "array"
    },
    "run_summary": {
      "$ref": "#/$defs/RunSummary"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "run_summary",
    "findings",
    "requirement_statuses",
    "isolation_proof",
    "model_stage_degraded",
    "provider_provenance"
  ],
  "title": "ReportBundle",
  "type": "object"
}
