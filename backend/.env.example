# --- App ---
ENV=dev
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000

# --- DataHub ---
# Set to false to enable the real GMS client below.
USE_MOCK_DATAHUB=true
DATAHUB_BASE_URL=http://localhost:8080
# DATAHUB_TOKEN=<your GMS personal access token>
DATAHUB_TIMEOUT=30
DATAHUB_MAX_RETRIES=3
DATAHUB_RATE_LIMIT_RPS=10.0

# --- Auth (OIDC) ---
# Leave AUTH_REQUIRED=false for local dev (mock user).
AUTH_REQUIRED=false
# OIDC_ISSUER=https://auth.example.com/
# OIDC_CLIENT_ID=cortex-backend
# OIDC_CLIENT_SECRET=<secret>

# --- Database (Postgres) ---
# Leave empty to run without a DB (JSONL writeback only).
# DATABASE_URL=postgresql+asyncpg://cortex:cortex@localhost:5432/cortex
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Observability ---
ENABLE_TRACING=false
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_ENABLED=true

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Write-back ---
WRITEBACK_PATH=data/writeback.jsonl
