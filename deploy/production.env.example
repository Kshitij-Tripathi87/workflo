# Production environment template.
# Copy to .env (gitignored) and load via SSM / Vault / 1Password.

ENV=prod
LOG_LEVEL=WARNING
FRONTEND_URL=https://cortex.example.com

USE_MOCK_DATAHUB=false
DATAHUB_BASE_URL=https://datahub.example.com
DATAHUB_TOKEN=__LOAD_FROM_SECRET_MANAGER__
DATAHUB_TIMEOUT=30
DATAHUB_RATE_LIMIT_RPS=10.0

AUTH_REQUIRED=true
OIDC_ISSUER=https://auth.example.com/
OIDC_CLIENT_ID=cortex-backend
OIDC_CLIENT_SECRET=__LOAD_FROM_SECRET_MANAGER__

DATABASE_URL=postgresql+asyncpg://cortex:__LOAD_FROM_SECRET_MANAGER__@postgres-prod:5432/cortex
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

RATE_LIMIT_PER_MINUTE=60
