# Staging environment template.
# Copy to .env (gitignored) and fill in real values.

ENV=staging
LOG_LEVEL=INFO
FRONTEND_URL=https://cortex-staging.example.com

USE_MOCK_DATAHUB=false
DATAHUB_BASE_URL=https://datahub-staging.example.com
DATAHUB_TOKEN=__REPLACE_WITH_SECRET__
DATAHUB_TIMEOUT=30

AUTH_REQUIRED=true
OIDC_ISSUER=https://auth.example.com/
OIDC_CLIENT_ID=cortex-backend
OIDC_CLIENT_SECRET=__REPLACE_WITH_SECRET__

DATABASE_URL=postgresql+asyncpg://cortex:__REPLACE_WITH_SECRET__@postgres-host:5432/cortex
DB_POOL_SIZE=10

METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
