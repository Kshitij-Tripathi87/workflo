# Workflo compose environment
# Copy to compose.env, fill in secrets, then run:
#   docker compose --env-file compose.env up

# Required: generate a strong DB password
POSTGRES_PASSWORD=__CHANGE_ME__
POSTGRES_USER=workflo
POSTGRES_DB=workflo

# Backend
COMPOSE_ENV=dev
USE_MOCK_DATAHUB=true
AUTH_REQUIRED=false
FRONTEND_URL=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000