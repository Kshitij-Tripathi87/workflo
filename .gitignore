# Model artifacts are staged out-of-band and pinned by SHA-256 in the release
# manifest; never commit multi-GB weights or adapters to Git.
*.gguf
# Regenerated by the app during local runs; committing these makes every
# test/dev run produce a diff that looks like real incident data.
data/
pids
*.pid
*.pid.lock

